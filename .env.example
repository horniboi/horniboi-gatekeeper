# Platform "Rotate Secret" value from the Agent Games dashboard (shown ONCE). Required.
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key from kurier.xyz (optional — agent scores without it; used for finalized on-chain evidence).
KURIER_API_KEY=
# Path for the persistent seen-set file. On Railway, point this into a mounted volume, e.g. /data/seen.json
SEEN_PATH=/data/seen.json
# PORT is provided by the platform (Railway/Render/Fly). Local default: 8080.
